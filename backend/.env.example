# ETFWorld 环境配置文件
# 复制此文件为 .env 并填入实际配置

# Tushare配置
# 在 https://tushare.pro 注册获取
# ⭐️ TUSHARE_API_URL 必须保持为自定义数据源地址，否则会提示 "Token 不对"
TUSHARE_TOKEN=你的Tushare_Token
TUSHARE_API_URL=https://ttx.dailyfetch.top/

# AI 研判（可选，驱动 AI 研判侧栏）
# 任意兼容 OpenAI Chat Completions 协议的服务均可，例如：
#   DeepSeek: https://api.deepseek.com/chat/completions 模型 deepseek-chat
#   Kimi:     https://api.moonshot.cn/v1/chat/completions 模型以开放平台为准
# 留空则 AI 研判回退到规则结论。旧变量名 DEEPSEEK_* 仍兼容读取。
AI_API_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=请填入你的AI_Key
AI_MODEL=deepseek-chat

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=etfworld
DB_USER=postgres
DB_PASSWORD=your_password

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=etfworld.log
